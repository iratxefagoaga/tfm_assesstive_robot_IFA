<?xml version="1.0"?>
<sdf version="1.9">
  <model name="home">
    <static>true</static>

    <!-- 24 x 18 m accessible home. Coordinate origin is the geometric centre. -->
    <link name="floor">
      <pose>0 0 -0.05 0 0 0</pose>
      <collision name="collision"><geometry><box><size>24 18 0.1</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>24 18 0.1</size></box></geometry><material><diffuse>0.72 0.64 0.52 1</diffuse></material></visual>
    </link>

    <!-- Exterior walls, 0.20 m thick and 2.70 m high. South wall leaves a 1.80 m entrance. -->
    <link name="wall_north"><pose>0 8.9 1.35 0 0 0</pose><collision name="c"><geometry><box><size>24 0.2 2.7</size></box></geometry></collision><visual name="v"><geometry><box><size>24 0.2 2.7</size></box></geometry><material><diffuse>0.92 0.90 0.84 1</diffuse></material></visual></link>
    <link name="wall_west"><pose>-11.9 0 1.35 0 0 0</pose><collision name="c"><geometry><box><size>0.2 18 2.7</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 18 2.7</size></box></geometry><material><diffuse>0.92 0.90 0.84 1</diffuse></material></visual></link>
    <link name="wall_east"><pose>11.9 0 1.35 0 0 0</pose><collision name="c"><geometry><box><size>0.2 18 2.7</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 18 2.7</size></box></geometry><material><diffuse>0.92 0.90 0.84 1</diffuse></material></visual></link>
    <link name="wall_south_left"><pose>-6.45 -8.9 1.35 0 0 0</pose><collision name="c"><geometry><box><size>10.9 0.2 2.7</size></box></geometry></collision><visual name="v"><geometry><box><size>10.9 0.2 2.7</size></box></geometry><material><diffuse>0.92 0.90 0.84 1</diffuse></material></visual></link>
    <link name="wall_south_right"><pose>6.45 -8.9 1.35 0 0 0</pose><collision name="c"><geometry><box><size>10.9 0.2 2.7</size></box></geometry></collision><visual name="v"><geometry><box><size>10.9 0.2 2.7</size></box></geometry><material><diffuse>0.92 0.90 0.84 1</diffuse></material></visual></link>

    <!-- North sleeping zone.
         Two 3.0 m accessible openings define the experimental alternatives:
         WEST (-7 to -4) and CENTRAL (2 to 5).
         Collision and visual geometry are identical. -->

    <!-- Wall from exterior west boundary to WEST opening. -->
    <link name="north_partition_west">
      <pose>-9.45 4.0 1.35 0 0 0</pose>
      <collision name="c"><geometry><box><size>4.9 0.2 2.7</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>4.9 0.2 2.7</size></box></geometry>
        <material><diffuse>0.88 0.87 0.82 1</diffuse></material>
      </visual>
    </link>

    <!-- Wall separating WEST and CENTRAL openings. -->
    <link name="north_partition_middle">
      <pose>-1.0 4.0 1.35 0 0 0</pose>
      <collision name="c"><geometry><box><size>6.0 0.2 2.7</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>6.0 0.2 2.7</size></box></geometry>
        <material><diffuse>0.88 0.87 0.82 1</diffuse></material>
      </visual>
    </link>

    <!-- Wall from CENTRAL opening to exterior east boundary. -->
    <link name="north_partition_east">
      <pose>8.45 4.0 1.35 0 0 0</pose>
      <collision name="c"><geometry><box><size>6.9 0.2 2.7</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>6.9 0.2 2.7</size></box></geometry>
        <material><diffuse>0.88 0.87 0.82 1</diffuse></material>
      </visual>
    </link>

    <!-- Bedroom/bathroom vertical separators. -->
    <link name="bed1_bath_wall"><pose>-4.5 6.45 1.35 0 0 0</pose><collision name="c"><geometry><box><size>0.2 4.9 2.7</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 4.9 2.7</size></box></geometry><material><diffuse>0.88 0.87 0.82 1</diffuse></material></visual></link>
    <link name="bath_bed2_wall"><pose>1.5 6.45 1.35 0 0 0</pose><collision name="c"><geometry><box><size>0.2 4.9 2.7</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 4.9 2.7</size></box></geometry><material><diffuse>0.88 0.87 0.82 1</diffuse></material></visual></link>

    <!-- West kitchen/study separation. Openings intentionally wide. -->
    <link name="west_zone_wall_upper"><pose>-4.0 2.6 1.35 0 0 0</pose><collision name="c"><geometry><box><size>0.2 2.8 2.7</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 2.8 2.7</size></box></geometry><material><diffuse>0.88 0.87 0.82 1</diffuse></material></visual></link>
    <link name="west_zone_wall_lower"><pose>-4.0 -4.7 1.35 0 0 0</pose><collision name="c"><geometry><box><size>0.2 8.4 2.7</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 8.4 2.7</size></box></geometry><material><diffuse>0.88 0.87 0.82 1</diffuse></material></visual></link>

    <!-- Living/dining furniture. Central table supports the future narrow-vs-wide route experiment. -->
    <link name="living_sofa"><pose>7.8 -4.9 0.45 0 0 0</pose><collision name="c"><geometry><box><size>3.2 1.0 0.9</size></box></geometry></collision><visual name="v"><geometry><box><size>3.2 1.0 0.9</size></box></geometry><material><diffuse>0.16 0.32 0.48 1</diffuse></material></visual></link>
    <link name="living_armchair"><pose>10.0 -2.2 0.45 0 0 0</pose><collision name="c"><geometry><box><size>1.0 1.0 0.9</size></box></geometry></collision><visual name="v"><geometry><box><size>1.0 1.0 0.9</size></box></geometry><material><diffuse>0.20 0.38 0.52 1</diffuse></material></visual></link>
    <link name="living_coffee_table"><pose>7.5 -2.8 0.25 0 0 0</pose><collision name="c"><geometry><box><size>1.5 0.8 0.5</size></box></geometry></collision><visual name="v"><geometry><box><size>1.5 0.8 0.5</size></box></geometry><material><diffuse>0.36 0.18 0.08 1</diffuse></material></visual></link>
    <link name="dining_table"><pose>0.5 2.5 0.38 0 0 0</pose><collision name="c"><geometry><box><size>2.0 1.0 0.76</size></box></geometry></collision><visual name="v"><geometry><box><size>2.0 1.0 0.76</size></box></geometry><material><diffuse>0.34 0.16 0.06 1</diffuse></material></visual></link>
    <link name="tv_unit"><pose>10.8 -5.2 0.35 0 0 0</pose><collision name="c"><geometry><box><size>0.45 2.4 0.7</size></box></geometry></collision><visual name="v"><geometry><box><size>0.45 2.4 0.7</size></box></geometry><material><diffuse>0.22 0.18 0.14 1</diffuse></material></visual></link>

    <!-- Kitchen. -->
    <link name="kitchen_counter_west"><pose>-11.1 -3.0 0.45 0 0 0</pose><collision name="c"><geometry><box><size>0.6 6.5 0.9</size></box></geometry></collision><visual name="v"><geometry><box><size>0.6 6.5 0.9</size></box></geometry><material><diffuse>0.72 0.72 0.70 1</diffuse></material></visual></link>
    <link name="kitchen_counter_south"><pose>-8.0 -7.8 0.45 0 0 0</pose><collision name="c"><geometry><box><size>6.0 0.6 0.9</size></box></geometry></collision><visual name="v"><geometry><box><size>6.0 0.6 0.9</size></box></geometry><material><diffuse>0.72 0.72 0.70 1</diffuse></material></visual></link>
    <link name="kitchen_island"><pose>-7.4 -3.2 0.45 0 0 0</pose><collision name="c"><geometry><box><size>2.4 1.1 0.9</size></box></geometry></collision><visual name="v"><geometry><box><size>2.4 1.1 0.9</size></box></geometry><material><diffuse>0.48 0.34 0.22 1</diffuse></material></visual></link>
    <link name="fridge"><pose>-10.8 1.8 1.0 0 0 0</pose><collision name="c"><geometry><box><size>0.8 0.9 2.0</size></box></geometry></collision><visual name="v"><geometry><box><size>0.8 0.9 2.0</size></box></geometry><material><diffuse>0.72 0.76 0.78 1</diffuse></material></visual></link>

    <!-- Study. -->
    <link name="study_desk"><pose>-8.5 2.6 0.38 0 0 0</pose><collision name="c"><geometry><box><size>2.0 0.75 0.76</size></box></geometry></collision><visual name="v"><geometry><box><size>2.0 0.75 0.76</size></box></geometry><material><diffuse>0.36 0.20 0.10 1</diffuse></material></visual></link>
    <link name="study_bookcase"><pose>-11.3 2.0 1.0 0 0 0</pose><collision name="c"><geometry><box><size>0.45 2.5 2.0</size></box></geometry></collision><visual name="v"><geometry><box><size>0.45 2.5 2.0</size></box></geometry><material><diffuse>0.30 0.18 0.10 1</diffuse></material></visual></link>

    <!-- Bedrooms. -->
    <link name="bedroom1_bed"><pose>-8.0 6.7 0.30 0 0 0</pose><collision name="c"><geometry><box><size>2.1 1.6 0.6</size></box></geometry></collision><visual name="v"><geometry><box><size>2.1 1.6 0.6</size></box></geometry><material><diffuse>0.72 0.76 0.82 1</diffuse></material></visual></link>
    <link name="bedroom1_wardrobe"><pose>-11.2 6.5 1.1 0 0 0</pose><collision name="c"><geometry><box><size>0.55 2.6 2.2</size></box></geometry></collision><visual name="v"><geometry><box><size>0.55 2.6 2.2</size></box></geometry><material><diffuse>0.42 0.28 0.16 1</diffuse></material></visual></link>
    <link name="bedroom2_bed"><pose>6.4 6.7 0.30 0 0 0</pose><collision name="c"><geometry><box><size>2.1 1.6 0.6</size></box></geometry></collision><visual name="v"><geometry><box><size>2.1 1.6 0.6</size></box></geometry><material><diffuse>0.76 0.72 0.82 1</diffuse></material></visual></link>
    <link name="bedroom2_wardrobe"><pose>10.9 6.6 1.1 0 0 0</pose><collision name="c"><geometry><box><size>0.55 2.8 2.2</size></box></geometry></collision><visual name="v"><geometry><box><size>0.55 2.8 2.2</size></box></geometry><material><diffuse>0.42 0.28 0.16 1</diffuse></material></visual></link>

    <!-- Bathroom fixtures. -->
    <link name="bath_shower"><pose>-2.9 7.3 1.0 0 0 0</pose><collision name="c"><geometry><box><size>1.3 1.3 2.0</size></box></geometry></collision><visual name="v"><geometry><box><size>1.3 1.3 2.0</size></box></geometry><material><diffuse>0.70 0.86 0.90 0.7</diffuse></material></visual></link>
    <link name="bath_sink"><pose>0.7 7.7 0.45 0 0 0</pose><collision name="c"><geometry><box><size>0.65 1.0 0.9</size></box></geometry></collision><visual name="v"><geometry><box><size>0.65 1.0 0.9</size></box></geometry><material><diffuse>0.92 0.92 0.90 1</diffuse></material></visual></link>
    <link name="bath_toilet"><pose>0.5 5.4 0.4 0 0 0</pose><collision name="c"><geometry><box><size>0.7 0.8 0.8</size></box></geometry></collision><visual name="v"><geometry><box><size>0.7 0.8 0.8</size></box></geometry><material><diffuse>0.94 0.94 0.92 1</diffuse></material></visual></link>

    <!-- Decorative plants are also physical obstacles. -->
    <link name="plant_living"><pose>10.6 2.6 0.45 0 0 0</pose><collision name="c"><geometry><cylinder><radius>0.32</radius><length>0.9</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.32</radius><length>0.9</length></cylinder></geometry><material><diffuse>0.08 0.38 0.12 1</diffuse></material></visual></link>
    <link name="plant_hall"><pose>-1.4 -6.8 0.40 0 0 0</pose><collision name="c"><geometry><cylinder><radius>0.28</radius><length>0.8</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.28</radius><length>0.8</length></cylinder></geometry><material><diffuse>0.08 0.38 0.12 1</diffuse></material></visual></link>
  </model>
</sdf>
